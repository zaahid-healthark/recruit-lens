# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Override for any other PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/interview_evaluator?schema=public"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Shared secret the mobile app sends in the `x-api-key` header (keep in sync with mobile/.env)
API_KEY=dev-secret-change-me
# Where uploaded audio files are stored (LocalDiskStorage)
STORAGE_DIR=./uploads

# ── AI pipeline ──────────────────────────────────────────────────────────────
# MOCK_AI=true returns canned transcripts/evaluations WITHOUT calling OpenAI (zero cost).
# Flip to false and set OPENAI_API_KEY to use the real pipeline.
MOCK_AI=true
OPENAI_API_KEY=
# WHERE THE MONEY GOES, for a 20-minute interview that passes screening:
#   full transcription  ~$0.12   (~70% — billed per minute of audio)
#   scoring             ~$0.03
#   screening clip      ~$0.005
#   screening decision  ~$0.002
# Audio is the cost, not the text models. To cut it, shorten or cheapen
# transcription — swapping the chat models barely moves the total.

# Full transcription, used for evaluation. gpt-4o-transcribe-diarize returns
# speaker-labelled segments, which is what lets scoring judge the CANDIDATE
# rather than the recruiter. gpt-4o-mini-transcribe is about half the price
# but returns no speaker labels — cheaper, and noticeably blunter scoring.
# Fallbacks (tried automatically if rejected): gpt-4o-transcribe, whisper-1.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize

# Evaluation model (chat completions). GPT-5-family models ignore custom
# temperature — the server adapts parameters per model family automatically.
OPENAI_EVAL_MODEL=gpt-5.4

# ── Screening gate (auto-uploaded calls only) ────────────────────────────────
# Set false to accept every auto-upload without screening — personal calls
# then reach the server, so this is for debugging, not for daily use.
SCREEN_AUTO_UPLOADS=true
# Seconds of audio the verdict is based on. Billed per minute, so this is the
# main lever on screening cost. Whether a call is a job discussion is usually
# clear within the first minute.
SCREENING_SECONDS=90
# Deliberately the mini model: the gate only decides recruitment-or-not, which
# needs neither speaker labels nor full accuracy.
OPENAI_SCREENING_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# Chat model for the verdict itself. Costs ~$0.002/call, so cheapening it
# saves almost nothing — left configurable for completeness.
# OPENAI_SCREENING_MODEL=

# How many recordings the bulk queue evaluates in parallel (1 = sequential)
BULK_CONCURRENCY=1

# ── Google Drive mirror (optional) ───────────────────────────────────────────
# When configured, every recording is mirrored into the Drive folder below:
# audio files → "Recordings/", transcripts → "Transcripts/", and one row per
# recording in an auto-created "Evaluations" Google Sheet. See README section
# "Google Drive mirror" for the service-account setup steps.
# The folder ID is the last part of the folder's URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_FOLDER_ID=
# Path to the service-account JSON key (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
