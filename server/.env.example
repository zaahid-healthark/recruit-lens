# ── Database ─────────────────────────────────────────────────────────────────
# Matches docker-compose.yml. Override for any other PostgreSQL instance.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/interview_evaluator?schema=public"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=4000
# Shared secret the mobile app sends in the `x-api-key` header (keep in sync with mobile/.env)
API_KEY=dev-secret-change-me
# Where uploaded audio files are stored (LocalDiskStorage)
STORAGE_DIR=./uploads

# ── AI pipeline ──────────────────────────────────────────────────────────────
# MOCK_AI=true returns canned transcripts/evaluations WITHOUT calling OpenAI (zero cost).
# Flip to false and set OPENAI_API_KEY to use the real pipeline.
MOCK_AI=true
OPENAI_API_KEY=
# Transcription model. gpt-4o-transcribe-diarize returns speaker-labelled segments.
# Fallbacks (tried automatically if this one is rejected): gpt-4o-transcribe, whisper-1.
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe-diarize
# Evaluation model (chat completions). GPT-5-family models ignore custom temperature —
# the server adapts parameters per model family automatically.
OPENAI_EVAL_MODEL=gpt-5.4
# How many recordings the bulk queue evaluates in parallel (1 = sequential)
BULK_CONCURRENCY=1

# ── Google Drive mirror (optional) ───────────────────────────────────────────
# When configured, every recording is mirrored into the Drive folder below:
# audio files → "Recordings/", transcripts → "Transcripts/", and one row per
# recording in an auto-created "Evaluations" Google Sheet. See README section
# "Google Drive mirror" for the service-account setup steps.
# The folder ID is the last part of the folder's URL: drive.google.com/drive/folders/<ID>
GOOGLE_DRIVE_FOLDER_ID=
# Path to the service-account JSON key (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
