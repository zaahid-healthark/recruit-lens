{
  "name": "@interview-evaluator/server",
  "version": "1.0.0",
  "private": true,
  "description": "Interview Evaluator backend — Express + Prisma + OpenAI pipeline",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "seed": "prisma db seed",
    "studio": "prisma studio",
    "drive:sync": "tsx scripts/driveSyncAll.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@interview-evaluator/shared": "*",
    "@prisma/client": "^5.22.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ffmpeg-static": "^5.2.0",
    "googleapis": "^173.0.0",
    "multer": "^2.0.1",
    "openai": "^4.104.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.16",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
