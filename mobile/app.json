{
  "expo": {
    "name": "Interview Evaluator",
    "slug": "interview-evaluator",
    "version": "2.2.0",
    "orientation": "portrait",
    "scheme": "interviewevaluator",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios"
    ],
    "android": {
      "package": "com.healthark.interviewevaluator",
      "versionCode": 11
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "audio/*",
            "application/ogg",
            "video/3gpp"
          ],
          "androidMultiIntentFilters": [
            "audio/*"
          ],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          },
          "disableIOS": true
        }
      ],
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "extra": {
      "apiBaseUrl": "",
      "apiKey": "",
      "eas": {
        "projectId": "5a49ac51-ca8d-4487-b862-e3a47f424acb"
      }
    },
    "owner": "mihir.r_com"
  }
}
