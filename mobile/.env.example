# Copy to mobile/.env — values are inlined into the JS bundle at build time,
# so RESTART `npm run dev:mobile` after changing them.

# Where the backend runs, AS REACHABLE FROM THE PHONE:
#  - Android emulator:   http://10.0.2.2:4000   (special alias for the host machine)
#  - Physical device:    http://<your PC's LAN IP>:4000   e.g. http://192.168.1.50:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Must match API_KEY in server/.env
EXPO_PUBLIC_API_KEY=dev-secret-change-me
