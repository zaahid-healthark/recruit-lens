# Copy to mobile/.env — used by `npm run dev:mobile` (Metro / dev build).
# Values are inlined into the JS bundle at build time, so RESTART Metro after changing them.
#
# NOTE: this file is only for local development. A cloud APK built with
# `eas build` does NOT read it (.env is gitignored and never uploaded) —
# set the same two values in mobile/eas.json under the build profile's `env`.

# Where the backend runs, AS REACHABLE FROM THE PHONE:
#  - Deployed on Render:  https://<your-service>.onrender.com
#  - Android emulator:    http://10.0.2.2:4000   (special alias for the host machine)
#  - Physical device + local server: http://<your PC's LAN IP>:4000   e.g. http://192.168.1.50:4000
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000

# Must match API_KEY in server/.env (or the API_KEY env var on Render)
EXPO_PUBLIC_API_KEY=dev-secret-change-me
